# Copia este archivo a .env y completa lo necesario.
# La API key también puede ingresarse desde la página (clic en el indicador de modo, arriba a la derecha).
# Si se define aquí, tiene prioridad sobre la de la página.
OPENAI_API_KEY=
# Contraseña del profesor: si la defines, se pide para cambiar la API key o el prompt,
# probar el prompt y ver/descargar el registro. ¡Defínela siempre que la página sea pública!
MEDIADOR_CLAVE_ADMIN=
# Modelo de OpenAI (por defecto gpt-5.4-mini)
MEDIADOR_MODELO=gpt-5.4-mini
# Rondas "sugeridas" antes de que la IA solo verifique tono/bloqueo
MEDIADOR_MAX_ITERACIONES=3
# "simulado" usa un evaluador heurístico sin llamar a la API (para probar la interfaz).
# Si no hay OPENAI_API_KEY se usa "simulado" automáticamente.
MEDIADOR_MODO=
# Opcionales (bot de Telegram y entrega por correo)
TELEGRAM_BOT_TOKEN=
PROFESOR_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
